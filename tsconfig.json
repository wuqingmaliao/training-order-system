{
  "extends": "./tsconfig.app.json",
  "compilerOptions": {
    "baseUrl": "./",
    "module": "commonjs",
    "moduleResolution": "node",
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "esModuleInterop": true,
    "target": "ES2022",
    "lib": ["ES2022"],
    "skipLibCheck": true,
    "paths": {
      "@client/*": ["client/*"],
      "@shared/*": ["shared/*"],
      "@/*": ["./client/src/*"],
      "@server/*": ["server/*"],
      "@lark-apaas/client-toolkit/tools/*": ["node_modules/@lark-apaas/client-toolkit/lib/apis/tools/*"]
    }
  },
  "include": [
    "client/**/*",
    "server/**/*",
    "api/**/*",
    "shared/**/*"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "public",
    "source_package",
    "client/src/api/gen"
  ],
  "references": [
    {
      "path": "./tsconfig.node.json"
    }
  ]
}
